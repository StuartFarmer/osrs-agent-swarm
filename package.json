{
  "name": "osrs-bot-swarm",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:names": "python3 -m unittest discover -s scripts -p 'test_collect_hiscore_names.py'",
    "check": "npm run typecheck && npm test && npm run test:names",
    "swarm": "node --import tsx src/cli.ts",
    "prepare:sdk": "node scripts/prepare-sdk.mjs",
    "pretest": "npm run prepare:sdk",
    "preswarm": "npm run prepare:sdk"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "billion-context": "0.1.216",
    "puppeteer": "24.40.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
